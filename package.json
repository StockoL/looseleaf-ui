{
  "name": "looseleaf-ui",
  "version": "2.0.0",
  "description": "Bespoke, architecture-first CUBE CSS design system template library.",
  "main": "dist/looseleaf.css",
  "style": "dist/looseleaf.css",
  "bin": {
    "looseleaf-ui": "scripts/cli.js"
  },
  "exports": {
    ".": "./dist/looseleaf.css",
    "./css": "./dist/looseleaf.css",
    "./src/*": "./src/*",
    "./design-tokens.json": "./design-tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "design-tokens.json",
    "scripts/cli.js",
    "scripts/tokens-core.mjs",
    "scripts/utopia.mjs",
    "scripts/color.mjs"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.js",
    "build:tools": "node scripts/build-tools.js",
    "build:css": "node scripts/build-css.js",
    "build:django": "node scripts/build-django.js",
    "check": "node scripts/check.js",
    "test": "node --test \"scripts/*.test.mjs\"",
    "test:browser": "playwright test --grep-invert @nojs",
    "test:nojs": "playwright test --grep @nojs",
    "bump": "node scripts/bump-version.js",
    "build": "npm run build:tokens && npm run build:tools && npm run build:css && npm run build:django && npm run check"
  },
  "keywords": [
    "css",
    "cube-css",
    "design-tokens",
    "responsive-design",
    "accessibility"
  ],
  "author": "Louis Stockton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StockoL/looseleaf-ui.git"
  },
  "bugs": {
    "url": "https://github.com/StockoL/looseleaf-ui/issues"
  },
  "homepage": "https://github.com/StockoL/looseleaf-ui#readme",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
